+                    lora_request=it.get("lora_request"),
+                    tokenization_kwargs=it.get("tokenization_kwargs"),
+                    trace_headers=it.get("trace_headers"),
+                    priority=it.get("priority", 0),
+                    data_parallel_rank=it.get("data_parallel_rank"),
+                    session_id=it.get("session_id"),
+                )
+                prompt_text, _, _ = extract_prompt_components(self.model_config, prompt)
+            self.input_processor.assign_request_id(req)
